# =====================================================
# ⚙️ JURISLINK - CONFIGURAÇÃO DE VARIÁVEIS DE AMBIENTE
# =====================================================
# Este arquivo mostra todas as variáveis necessárias
# Organize por serviço para facilitar o deploy
#
# LEGENDA:
# 🔴 OBRIGATÓRIO - Precisa configurar
# 🟡 OPCIONAL - Funciona sem, mas pode melhorar
# 🟢 RENDER - Variável para o backend no Render
# 🔵 VERCEL - Variável para o frontend no Vercel
# 🟣 SUPABASE - Variável do banco de dados


# =====================================================
# 🔴 SUPABASE (BANCO DE DADOS)
# =====================================================
# Onde encontrar:
# 1. Vá em: https://supabase.com/dashboard
# 2. Selecione seu projeto
# 3. Settings → API
# 4. Copie as URLs e Keys

NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-aqui
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-aqui


# =====================================================
# 🔴 RESEND (ENVIO DE EMAILS)
# =====================================================
# Onde encontrar:
# 1. Crie conta em: https://resend.com
# 2. Vá em: https://resend.com/api-keys
# 3. Clique em "Create API Key"
# 4. Copie a chave (começa com re_)

RESEND_API_KEY=re_sua_api_key_aqui

# Email do remetente (use onboarding@resend.dev se não verificó seu domínio)
# Depois de verificar seu domínio, use: noreply@seu-dominio.com.br
SMTP_FROM=onboarding@resend.dev


# =====================================================
# 🔴 MERCADO PAGO (PAGAMENTOS)
# =====================================================
# Onde encontrar:
# 1. Crie conta em: https://www.mercadopago.com.br
# 2. Vá em: https://www.mercadopago.com.br/developers/panel
# 3. Crie sua aplicação
# 4. Obtenha o Access Token em Credenciais

NEXT_PUBLIC_MERCADO_PAGO_PUBLIC_KEY=TEST-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
MERCADO_PAGO_ACCESS_TOKEN=TEST-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
MERCADO_PAGO_WEBHOOK_SECRET=seu-webhook-secret-aqui

# Use 'true' para modo teste, 'false' para produção
MERCADO_PAGO_SANDBOX=true


# =====================================================
# 🔴 UPSTASH REDIS (RATE LIMITING)
# =====================================================
# Onde encontrar:
# 1. Crie conta em: https://upstash.com
# 2. Crie um banco Redis
# 3. Copie as variáveis REST_API_URL e REST_API_TOKEN

KV_REST_API_URL=https://seu-redis.upstash.io
KV_REST_API_TOKEN=seu-token-redis-aqui


# =====================================================
# 🔴 SECURITY (SEGURANÇA)
# =====================================================
# Gere estas chaves com comandos como:
# openssl rand -base64 32
# ou use: https://generate-random-strings.com/

# Chave para assinar tokens JWT (mínimo 32 caracteres)
JWT_SECRET=sua-jwt-secret-minimo-32-caracteres-aqui

# Chave para criptografia (exatamente 32 caracteres)
ENCRYPTION_KEY=chave-de-exatos-32-caracteres-aqui


# =====================================================
# 🔴 APP CONFIGURATION (CONFIGURAÇÃO DO APP)
# =====================================================
# URL do seu app no Vercel (sem barra no final)
# 🟢 VERCEL: Configure isso nas variáveis de ambiente do Vercel
NEXT_PUBLIC_APP_URL=https://seu-app.vercel.app

# URL de callback para autenticação (igual à APP_URL + /auth/callback)
# 🟢 VERCEL: Configure isso também
NEXT_PUBLIC_DEV_SUPABASE_REDIRECT_URL=https://seu-app.vercel.app/auth/callback

# Ambiente: development ou production
NODE_ENV=development


# =====================================================
# 🟡 ADMIN (ADMINISTRAÇÃO)
# =====================================================
ADMIN_EMAIL=admin@seu-dominio.com.br


# =====================================================
# 🟡 VERCEL BLOB (ARMAZENAMENTO DE ARQUIVOS)
# =====================================================
# Se não usar, pode comentar ou deixar vazio
# Onde encontrar:
# 1. Vá em: https://vercel.com/dashboard/blobs
# 2. Crie um bucket
# 3. Copie o token

# BLOB_READ_WRITE_TOKEN=seu-token-blob-aqui


# =====================================================
# 📋 RESUMO PARA DEPLOY
# =====================================================
#
# RENDER (Backend):
#   - NEXT_PUBLIC_SUPABASE_URL
#   - NEXT_PUBLIC_SUPABASE_ANON_KEY
#   - SUPABASE_SERVICE_ROLE_KEY
#   - RESEND_API_KEY
#   - MERCADO_PAGO_ACCESS_TOKEN
#   - MERCADO_PAGO_WEBHOOK_SECRET
#   - MERCADO_PAGO_SANDBOX
#   - KV_REST_API_URL
#   - KV_REST_API_TOKEN
#   - JWT_SECRET
#   - ENCRYPTION_KEY
#   - NEXT_PUBLIC_APP_URL
#   - NODE_ENV
#   - ADMIN_EMAIL
#
# VERCEL (Frontend):
#   - NEXT_PUBLIC_SUPABASE_URL
#   - NEXT_PUBLIC_SUPABASE_ANON_KEY
#   - NEXT_PUBLIC_APP_URL
#   - NEXT_PUBLIC_DEV_SUPABASE_REDIRECT_URL
#   - NEXT_PUBLIC_MERCADO_PAGO_PUBLIC_KEY
#   - MERCADO_PAGO_SANDBOX
#   - BLOB_READ_WRITE_TOKEN (se usar)
#
# OBS: Não exponha SUPABASE_SERVICE_ROLE_KEY no Vercel!
#      Ela deve ficar apenas no Render.
