# 🔐 JurisLink - Variáveis de Ambiente Completas

# ==========================================
# SUPABASE DATABASE/STORAGE (OBRIGATÓRIO)
# ==========================================
# Usado como banco Postgres e Storage. A autenticação do app agora é própria.
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-aqui
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-aqui

# ==========================================
# UPSTASH REDIS (OBRIGATÓRIO)
# ==========================================
KV_REST_API_URL=https://seu-redis.upstash.io
KV_REST_API_TOKEN=seu-token-redis

# ==========================================
# MERCADO PAGO (OBRIGATÓRIO PARA PAGAMENTOS)
# ==========================================
NEXT_PUBLIC_MERCADO_PAGO_PUBLIC_KEY=TEST-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
MERCADO_PAGO_ACCESS_TOKEN=TEST-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
MERCADO_PAGO_WEBHOOK_SECRET=seu-webhook-secret-123
MERCADO_PAGO_SANDBOX=true

# ==========================================
# APP CONFIGURATION
# ==========================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
JWT_EXPIRES_IN=7d
SESSION_COOKIE_NAME=jurislink_session

# ==========================================
# GOOGLE OAUTH
# ==========================================
GOOGLE_CLIENT_ID=seu-google-client-id
GOOGLE_CLIENT_SECRET=seu-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/callback

# ==========================================
# VERCEL BLOB STORAGE
# ==========================================
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxx

# ==========================================
# SECURITY (OBRIGATÓRIO)
# ==========================================
JWT_SECRET=gere-um-secret-super-seguro-de-no-minimo-32-caracteres-aqui
ENCRYPTION_KEY=chave-de-exatos-32-caracteres!!

# ==========================================
# EMAIL / RESEND
# ==========================================
RESEND_API_KEY=re_sua_api_key
EMAIL_FROM=JurisLink <noreply@jurislink.com.br>

# ==========================================
# ADMIN
# ==========================================
ADMIN_EMAIL=admin@jurislink.com.br

# ==========================================
# NODE ENVIRONMENT
# ==========================================
NODE_ENV=development
